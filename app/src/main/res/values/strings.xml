    <string name="accessibility_service_description">detects simultaneous volume up and volume down keypress to trigger capture. no screen content is read before capture.</string>
    
    <!-- disclosure -->
    <string name="disclosure_title">accessibility disclosure</string>
    <string name="disclosure_heading">_init_ /space uses accessibility to detect capture shortcuts</string>
    <string name="disclosure_intro_body">the accessibility service listens for the simultaneous volume up and volume down keypress to trigger capture. no keystrokes, personal data, or screen content are monitored or logged outside active capture sessions.</string>
    <string name="disclosure_step_1">step 1</string>
    <string name="disclosure_step_2">step 2</string>
    <string name="disclosure_step_3">step 3</string>
    <string name="disclosure_reason_title">purpose</string>
    <string name="disclosure_reason_body">the service detects the hardware shortcut so you can capture screenshots, text notes, and voice memos instantly from any screen.</string>
    <string name="disclosure_usage_title">usage</string>
    <string name="disclosure_usage_body">when the dual volume key gesture is pressed, the service takes a screenshot and displays the capture panel.</string>
    <string name="disclosure_permissions_title">permissions</string>
    <string name="disclosure_permission_media">photos and media: stores and reads captures on this device.</string>
    <string name="disclosure_permission_mic">microphone: records voice memos when chosen.</string>
    <string name="disclosure_permission_notifications">notifications: delivers scheduled reminders.</string>
    <string name="disclosure_limit_title">privacy</string>
    <string name="disclosure_limit_body">_init_ /space does not track typed input, inspect notifications, or monitor other applications.</string>
    <string name="disclosure_storage_body">all captures, notes, and voice recordings remain stored locally on device unless explicitly shared.</string>
